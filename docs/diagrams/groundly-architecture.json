  "cards": [
    {
      "dot": "cyan",
      "title": "Layers and processes",
      "items": [
        "Clients → services → foundations, one direction (import-linter)",
        "Processes: host-spawned MCP server, one-shot CLI runs, groundly serve, the extraction subprocess",
        "They share store.db through SQLite WAL + busy_timeout"
      ]
    },
    {
      "dot": "violet",
      "title": "Proposed in this design",
      "items": [
        "The host indexes through MCP; the run continues in the server and the host follows it with list_materials",
        "Lifecycle operations exist on both surfaces through the same service code",
        "One indexer per subject across all processes"
      ]
    },
    {
      "dot": "rose",
      "title": "No LLM, no key; privacy",
      "items": [
        "Only local bge-m3 and the reranker; the host composes and generates",
        "Network: model downloads from Hugging Face and pinned OCR models from modelscope.cn, nothing else",
        "progress.db is never exported; MCP HTTP and the page bind 127.0.0.1"
      ]
    },
    {
      "dot": "slate",
      "title": "Not drawn",
      "items": [
        "list_subjects, list_materials, outline, get_page, title, remove and drop read or change the store directly",
        "The page will also read mastery from progress.db (planned)"
      ]
    }
  ]
